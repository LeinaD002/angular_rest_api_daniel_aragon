{
  "openapi": "3.0.3",
  "info": {
    "title": "Backend Angular 20 - Products API",
    "version": "1.1.0",
    "description": "API REST didáctica para Angular 20: CRUD de productos y categorías, búsqueda, filtros, paginación, validaciones y HTTP Basic."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API local"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Estado del servicio"
    },
    {
      "name": "Products",
      "description": "Consulta y administración de productos"
    },
    {
      "name": "Categories",
      "description": "Consulta y administración de categorías"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Credenciales definidas en BASIC_AUTH_USERNAME y BASIC_AUTH_PASSWORD dentro de .env"
      }
    },
    "parameters": {
      "IdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador numérico",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 1
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Error de validación"
          },
          "data": {
            "nullable": true,
            "example": null
          },
          "meta": {
            "nullable": true,
            "example": null
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          },
          "data": {},
          "meta": {
            "nullable": true
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "sku": {
            "type": "string",
            "example": "TEC-001"
          },
          "name": {
            "type": "string",
            "example": "Teclado mecánico"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "example": "450.00"
          },
          "stock": {
            "type": "integer",
            "example": 25
          },
          "minStock": {
            "type": "integer",
            "example": 5
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "categoryId": {
            "type": "integer",
            "example": 2
          },
          "category": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "required": [
          "sku",
          "name",
          "price",
          "categoryId"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 50,
            "example": "WEB-101"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150,
            "example": "Webcam HD"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price": {
            "type": "number",
            "minimum": 0,
          "exclusiveMinimum": true,
            "example": 299.99
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 15
          },
          "minStock": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 3
          },
          "categoryId": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "example": true
          }
        }
      },
      "ProductUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 50,
            "example": "WEB-101"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150,
            "example": "Webcam HD"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price": {
            "type": "number",
            "minimum": 0,
          "exclusiveMinimum": true,
            "example": 299.99
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 15
          },
          "minStock": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 3
          },
          "categoryId": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "example": true
          }
        }
      },
      "CategoryInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Redes"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "example": "Equipos y accesorios de red"
          }
        }
      },
      "CategoryUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "totalItems": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Comprobar estado del backend",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                },
                "example": {
                  "success": true,
                  "message": "API disponible",
                  "data": {
                    "status": "ok"
                  },
                  "meta": null
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "get_products",
        "summary": "Listar productos con búsqueda, filtros, ordenamiento y paginación",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Número de página"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "description": "Resultados por página"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 150
            },
            "description": "Busca en nombre, SKU y descripción"
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "minStock",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "maxStock",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "isActive",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "lowStock",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "description": "Stock menor o igual a minStock"
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "sku",
                "price",
                "stock",
                "createdAt"
              ],
              "default": "createdAt"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de productos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                },
                "example": {
                  "success": true,
                  "message": "Productos obtenidos correctamente",
                  "data": [
                    {
                      "id": 1,
                      "sku": "TEC-001",
                      "name": "Teclado mecánico",
                      "price": "450.00",
                      "stock": 25,
                      "minStock": 5,
                      "categoryId": 2,
                      "category": {
                        "id": 2,
                        "name": "Accesorios"
                      }
                    }
                  ],
                  "meta": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 100,
                    "totalPages": 10,
                    "hasNextPage": true,
                    "hasPreviousPage": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales ausentes o incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Crear un producto",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              },
              "example": {
                "sku": "WEB-101",
                "name": "Webcam HD",
                "description": "Webcam para clases virtuales",
                "price": 299.99,
                "stock": 15,
                "minStock": 3,
                "categoryId": 2,
                "isActive": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Producto creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o categoría inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "SKU duplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/IdParam"
        }
      ],
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Obtener producto por ID",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Producto encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Producto no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Products"
        ],
        "summary": "Actualizar parcialmente un producto",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              },
              "example": {
                "price": 319.99,
                "stock": 20
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Producto actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Producto no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "SKU duplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "summary": "Desactivar producto (borrado lógico)",
        "description": "No elimina físicamente el registro; cambia isActive a false.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Producto desactivado; respuesta sin contenido"
          },
          "404": {
            "description": "Producto no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Listar categorías",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "includeInactive",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            },
            "description": "Incluir categorías inactivas"
          }
        ],
        "responses": {
          "200": {
            "description": "Categorías obtenidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                },
                "example": {
                  "success": true,
                  "message": "Categorías obtenidas correctamente",
                  "data": [
                    {
                      "id": 1,
                      "name": "Computación",
                      "description": "Computadoras y periféricos",
                      "isActive": true,
                      "_count": {
                        "products": 40
                      }
                    }
                  ],
                  "meta": null
                }
              }
            }
          },
          "401": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Categories"
        ],
        "summary": "Crear una categoría",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              },
              "example": {
                "name": "Redes",
                "description": "Equipos y accesorios de red"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Categoría creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Nombre duplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/categories/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/IdParam"
        }
      ],
      "patch": {
        "tags": [
          "Categories"
        ],
        "summary": "Actualizar parcialmente una categoría",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryUpdate"
              },
              "example": {
                "description": "Equipos de red y conectividad",
                "isActive": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Categoría actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Categoría no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Nombre duplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  }
}
