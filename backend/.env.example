# Aplicación
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# MySQL instalado localmente (ajusta usuario, contraseña y puerto)
# Usa una base de datos dedicada y vacía para este proyecto.
DATABASE_URL="mysql://app_user:app_password_local@localhost:3306/products_db"

# Base de datos shadow exclusiva para Prisma Migrate; debe existir y estar vacía.
SHADOW_DATABASE_URL="mysql://app_user:app_password_local@localhost:3306/products_shadow"

# Credenciales para HTTP Basic Authentication (solo para pruebas locales)
BASIC_AUTH_USERNAME=estudiante
BASIC_AUTH_PASSWORD=cambiar-esta-clave
